<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- A class library, not a host: it needs the ASP.NET Core assemblies for ControllerBase and
       [ApiController], but it owns no Program.cs and no appsettings. The runnable host is
       EnterpriseHR.WebApp, which adds this assembly as an MVC application part. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnterpriseHR.Domain\EnterpriseHR.Domain.csproj" />
    <ProjectReference Include="..\EnterpriseHR.DataAccess\EnterpriseHR.DataAccess.csproj" />
  </ItemGroup>

</Project>
