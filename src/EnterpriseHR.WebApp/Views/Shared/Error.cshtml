@model ErrorViewModel
@{
    var statusCode = ViewData["StatusCode"] as int?;
    var notFound = statusCode == StatusCodes.Status404NotFound;

    var heading = notFound ? "This page was not found" : "Something went wrong";
    var description = notFound
        ? "The address does not match a page in this workspace. Use the navigation above to return to a module."
        : "The request could not be completed. Try again, or return to the home page.";
}
<div class="page">
    <section class="panel error-state" role="alert">
        <span class="error-code">@(statusCode?.ToString() ?? "Error")</span>
        <h2>@heading</h2>
        <p>@description</p>
        <div class="button-row">
            <a class="button primary" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="muted mono">Request ID: @Model.RequestId</p>
        }
    </section>
</div>
