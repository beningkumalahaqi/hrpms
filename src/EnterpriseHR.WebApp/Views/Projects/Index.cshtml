@model IReadOnlyList<ProjectListItemDto>
@using System.Globalization
@using EnterpriseHR.Domain.Dtos
@{
    ViewData["Title"] = "Projects";

    // The export formats its dates as "Aug 3, 2026". That is pinned to the invariant culture
    // rather than the machine's: the screens are English throughout, and a host in another
    // locale would otherwise mix month names ("Agu 3, 2026") into the same table.
    string Date(DateTime value) =>
        value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);

    // Statuses map straight onto the export's badge classes (.badge.planning, .active,
    // .completed, .cancelled), and each pairs its colour with the icon the design system
    // specimen uses, so the state never relies on colour alone.
    string BadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "planning" => "planning",
        "cancelled" => "cancelled",
        "completed" => "completed",
        _ => "active",
    };

    string BadgeIcon(string status) => status.ToLowerInvariant() switch
    {
        "planning" => "i-clock",
        "cancelled" => "i-cancel",
        _ => "i-check-circle",
    };
}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <span class="eyebrow">Projects</span>
            <h1>Project portfolio</h1>
            <p class="page-description">Track project ownership, delivery dates, status, and active team allocations.</p>
        </div>
    </header>

    <section class="panel" aria-labelledby="projectPortfolioTitle">
        <div class="panel-header">
            <div class="panel-heading">
                <h2 id="projectPortfolioTitle">Projects</h2>
                <p>Active team counts include current employees only, ordered by start date.</p>
            </div>
            <span class="data-chip">@Model.Count @(Model.Count == 1 ? "project" : "projects")</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h2>No projects yet</h2>
                <p>The portfolio is empty. Projects appear here once they are scheduled.</p>
            </div>
        }
        else
        {
            <div class="desktop-table table-wrap">
                <table class="data-table">
                    <caption class="sr-only">Project portfolio</caption>
                    <thead>
                        <tr>
                            <th scope="col">Code</th>
                            <th scope="col">Project</th>
                            <th scope="col">Department</th>
                            <th scope="col">Start</th>
                            <th scope="col">End</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="numeric">Active team</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td><span class="mono">@project.ProjectCode</span></td>
                                <td><span class="cell-primary">@project.ProjectName</span></td>
                                <td>@project.DepartmentName</td>
                                <td class="od-nowrap">@Date(project.StartDate)</td>
                                <td class="od-nowrap">
                                    @if (project.EndDate is DateTime endDate)
                                    {
                                        @Date(endDate)
                                    }
                                    else
                                    {
                                        @* An open-ended project has no end date; the dash is
                                           hidden from assistive technology and replaced with
                                           a spoken label, as the directory does for a missing
                                           manager. *@
                                        <span class="muted" aria-hidden="true">&mdash;</span>
                                        <span class="sr-only">No end date</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @BadgeClass(project.Status)">
                                        <svg class="od-icon od-icon-status" aria-hidden="true" focusable="false"><use href="#@BadgeIcon(project.Status)" /></svg>
                                        <span>@project.Status</span>
                                    </span>
                                </td>
                                <td class="numeric">@project.ActiveMemberCount</td>
                                <td>
                                    <a class="button text" asp-action="Details" asp-route-id="@project.Id">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Below 1024px the export swaps the table for one record card per project. *@
            <div class="mobile-records">
                @foreach (var project in Model)
                {
                    <article class="record-card">
                        <div class="record-header">
                            <div class="record-title">
                                <strong>@project.ProjectName</strong>
                                <span class="mono">@project.ProjectCode</span>
                            </div>
                            <span class="badge @BadgeClass(project.Status)">
                                <svg class="od-icon od-icon-status" aria-hidden="true" focusable="false"><use href="#@BadgeIcon(project.Status)" /></svg>
                                <span>@project.Status</span>
                            </span>
                        </div>
                        <dl class="record-details">
                            <div><dt>Department</dt><dd>@project.DepartmentName</dd></div>
                            <div><dt>Active team</dt><dd>@project.ActiveMemberCount @(project.ActiveMemberCount == 1 ? "member" : "members")</dd></div>
                            <div><dt>Start date</dt><dd class="od-nowrap">@Date(project.StartDate)</dd></div>
                            <div>
                                <dt>End date</dt>
                                <dd class="od-nowrap">
                                    @if (project.EndDate is DateTime endDate)
                                    {
                                        @Date(endDate)
                                    }
                                    else
                                    {
                                        <span class="muted" aria-hidden="true">&mdash;</span>
                                        <span class="sr-only">No end date</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                        <div class="record-actions">
                            <a class="button secondary" asp-action="Details" asp-route-id="@project.Id">Details</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
