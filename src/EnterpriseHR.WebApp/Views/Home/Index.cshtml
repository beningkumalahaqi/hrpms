@{
    ViewData["Title"] = "Home";
}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <span class="eyebrow">HR Workspace</span>
            <h1>Home</h1>
            <p class="page-description">Employee records, project delivery and workforce reporting live in three modules.</p>
        </div>
    </header>

    <div class="module-grid">
        <a class="module-card" asp-controller="Employees" asp-action="Index">
            <span class="module-icon">
                <svg class="od-icon od-icon-large" aria-hidden="true" focusable="false"><use href="#i-users" /></svg>
            </span>
            <h2>Employees</h2>
            <p>Search the directory, maintain workplace details and manage employment status.</p>
            <span class="module-link">Open employees</span>
        </a>
        <a class="module-card" asp-controller="Projects" asp-action="Index">
            <span class="module-icon">
                <svg class="od-icon od-icon-large" aria-hidden="true" focusable="false"><use href="#i-briefcase" /></svg>
            </span>
            <h2>Projects</h2>
            <p>Track project status, budgets and the employees assigned to each engagement.</p>
            <span class="module-link">Open projects</span>
        </a>
        <a class="module-card" asp-controller="Dashboard" asp-action="Index">
            <span class="module-icon">
                <svg class="od-icon od-icon-large" aria-hidden="true" focusable="false"><use href="#i-dashboard" /></svg>
            </span>
            <h2>Dashboard</h2>
            <p>Department headcount, payroll totals and staffing summaries at a glance.</p>
            <span class="module-link">Open dashboard</span>
        </a>
    </div>
</div>
