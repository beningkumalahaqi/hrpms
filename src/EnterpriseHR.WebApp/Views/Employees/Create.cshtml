@model EmployeeCreateViewModel
@{
    ViewData["Title"] = "Create employee";

    // MVC puts the invalid-field class on the control itself, but it does not mark the control
    // as invalid for assistive technology. The design system keys its error border off
    // aria-invalid, so the attribute is emitted from ModelState here.
    string? Invalid(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0
            ? "true"
            : null;
}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <span class="eyebrow">Employees</span>
            <h1>Add employee</h1>
            <p class="page-description">Register a new employee. The position decides the salary range this record has to fit.</p>
        </div>
        <div class="page-actions">
            <a class="button secondary" asp-action="Index">Back to directory</a>
        </div>
    </header>

    <form method="post" asp-action="Create">
        <section class="panel" aria-labelledby="createEmployeeTitle">
            <div class="panel-header">
                <div class="panel-heading">
                    <h2 id="createEmployeeTitle">Employee details</h2>
                    <p>All fields are required unless the label says otherwise.</p>
                </div>
            </div>

            <div class="panel-body">
                <div asp-validation-summary="ModelOnly" class="error-summary" role="alert" tabindex="-1"></div>

                <div class="form-grid">
                    <div class="field od-field">
                        <label asp-for="EmployeeNumber">Employee number <span aria-hidden="true">*</span></label>
                        <input asp-for="EmployeeNumber" type="text" autocomplete="off"
                               aria-invalid="@Invalid(nameof(Model.EmployeeNumber))" aria-describedby="employeeNumberHelp" />
                        <small class="field-help" id="employeeNumberHelp">Unique across the company. It cannot be changed later.</small>
                        <span asp-validation-for="EmployeeNumber" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="FullName">Full name <span aria-hidden="true">*</span></label>
                        <input asp-for="FullName" type="text" autocomplete="name"
                               aria-invalid="@Invalid(nameof(Model.FullName))" />
                        <span asp-validation-for="FullName" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="Email">Email <span aria-hidden="true">*</span></label>
                        <input asp-for="Email" type="email" autocomplete="email"
                               aria-invalid="@Invalid(nameof(Model.Email))" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="JoinDate">Join date <span aria-hidden="true">*</span></label>
                        <input asp-for="JoinDate" type="date"
                               aria-invalid="@Invalid(nameof(Model.JoinDate))" aria-describedby="joinDateHelp" />
                        <small class="field-help" id="joinDateHelp">Accepts a typed date as well as the picker, in day/month/year order.</small>
                        <span asp-validation-for="JoinDate" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="DepartmentId">Department <span aria-hidden="true">*</span></label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments"
                                aria-invalid="@Invalid(nameof(Model.DepartmentId))">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="PositionId">Position <span aria-hidden="true">*</span></label>
                        <select asp-for="PositionId" asp-items="Model.Positions"
                                aria-invalid="@Invalid(nameof(Model.PositionId))" aria-describedby="positionHelp">
                            <option value="">-- Select --</option>
                        </select>
                        <small class="field-help" id="positionHelp">The monthly salary has to fit this position's range.</small>
                        <span asp-validation-for="PositionId" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="ManagerId">Manager</label>
                        <select asp-for="ManagerId" asp-items="Model.Managers"
                                aria-invalid="@Invalid(nameof(Model.ManagerId))" aria-describedby="managerHelp">
                            <option value="">-- No manager --</option>
                        </select>
                        <small class="field-help" id="managerHelp">Optional. Only active employees are listed.</small>
                        <span asp-validation-for="ManagerId" class="field-error"></span>
                    </div>

                    <div class="field od-field">
                        <label asp-for="Salary">Monthly salary <span aria-hidden="true">*</span></label>
                        <div class="input-prefix">
                            <span aria-hidden="true">Rp</span>
                            <input asp-for="Salary" type="number" min="0" step="0.01" inputmode="decimal"
                                   aria-invalid="@Invalid(nameof(Model.Salary))" aria-describedby="salaryHelp" />
                        </div>
                        <small class="field-help" id="salaryHelp">Gross monthly amount in IDR.</small>
                        <span asp-validation-for="Salary" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="panel-footer">
                <div class="form-actions">
                    <a class="button secondary" asp-action="Index">Cancel</a>
                    <button class="button primary" type="submit">Add employee</button>
                </div>
            </div>
        </section>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
